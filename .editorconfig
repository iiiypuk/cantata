# EditorConfig is awesome: https://EditorConfig.org
root = true

# for all files
[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# C
[{*.c,*.h}]
indent_style = space
indent_size = 2

# C++
[{*.cpp,*.hpp}]
indent_style = space
indent_size = 2

# Markdown
[*.md]
trim_trailing_whitespace = false
